# DeclineCraft settings. Copy this file to .env (same folder as the scripts) and edit it:
#     cp .env.example .env
# .env is git-ignored, so your keys stay local. Any variable left unset falls back to the default in config.py
# (the values shown here). Every model is reached through an OpenAI-compatible endpoint (vLLM, llama.cpp's
# llama-server, OpenRouter, ...); URLs end in /v1.

# --- Keys -----------------------------------------------------------------------------------------------------
# Key for your self-hosted endpoints, if they require one ("EMPTY" otherwise).
DC_API_KEY=EMPTY
# OpenRouter key, for closed models and the reference-answer oracle. Leave empty if you only use local models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Endpoints ------------------------------------------------------------------------------------------------
# Default endpoint for generation and judging, used when a script is not given --url.
DC_LLM_URL=http://localhost:8000/v1
# Embeddings (indexing, dense retrieval, question generation). Paper: Qwen3-Embedding-8B, Q8_0 GGUF, llama-server.
# Use the same embedding model for indexing and retrieval.
DC_EMBED_URL=http://localhost:8001/v1
DC_EMBED_MODEL=qwen3-embedding:8b-q8_0
# Cross-encoder reranker (verification; retrieval ablation). Paper: nvidia/llama-nemotron-rerank-1b-v2 on vLLM.
DC_RERANK_URL=http://localhost:8003/v1
DC_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# Query rewriting (only the hybrid_rewrite and full retrieval pipelines). Paper: Qwen3 30B-A3B, thinking disabled.
DC_REWRITE_URL=
DC_REWRITE_MODEL=

# --- Files ----------------------------------------------------------------------------------------------------
# Where corpora, the index and the query-rewrite cache are written.
DC_DATA_DIR=data
# Optional overrides of single paths (default: inside DC_DATA_DIR).
# DC_PRE_JSON=data/c_pre.json
# DC_POST_JSON=data/c_post.json
# DC_CHROMA_DB=data/chroma
# DC_REWRITE_CACHE=data/query_rewrites.json

# --- Generation -----------------------------------------------------------------------------------------------
# Output budget per answer, thinking included (paper: 16000), and the request timeout in seconds.
GENERATION_MAX_TOKENS=16000
GENERATION_TIMEOUT=1800
